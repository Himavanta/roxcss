    "css-in-js",
    "runtime",
    "styling",
    "tailwind",
    "template-literal",
    "utility-classes",
    "zero-dependency"
  ],
  "homepage": "https://github.com/Himavanta/roxcss#readme",
  "bugs": {
    "url": "https://github.com/Himavanta/roxcss/issues"
  },
  "license": "MIT",
  "author": "Himavanta@foxmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himavanta/roxcss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./core.min": "./dist/core.min.js",
    "./index.min": "./dist/index.min.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
